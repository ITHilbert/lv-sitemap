{
    "name": "ithilbert/sitemap",
    "type": "library",
    "license": "MIT",
    "description": "Sitemap-Generator für Laravel – Routen werden direkt als Sitemap-Einträge deklariert.",
    "keywords": [
        "it-hilbert",
        "laravel",
        "sitemap"
    ],
    "authors": [{
        "name": "Jörg Hilbert",
        "homepage": "https://www.it-hilbert.com",
        "role": "Developer"
    }],
    "homepage": "https://www.it-hilbert.com",
    "minimum-stability": "stable",
    "require": {
        "php": "^8.5",
        "ext-xmlwriter": "*",
        "illuminate/support": "^11.0 || ^12.0",
        "illuminate/console": "^11.0 || ^12.0",
        "illuminate/routing": "^11.0 || ^12.0",
        "illuminate/filesystem": "^11.0 || ^12.0",
        "nesbot/carbon": "^2.0 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "ITHilbert\\Sitemap\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ITHilbert\\Sitemap\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ITHilbert\\Sitemap\\SitemapServiceProvider"
            ],
            "aliases": {
                "Sitemap": "ITHilbert\\Sitemap\\Facades\\Sitemap"
            }
        }
    }
}
